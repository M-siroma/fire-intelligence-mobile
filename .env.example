# Copie este arquivo para ".env" e ajuste. Reinicie o "npx expo start" depois de mudar.

# URL da API FastAPI do Fire Intelligence (use o IP do computador na rede, não "localhost").
# Deixe vazio para usar o modo demonstração com dados simulados.
EXPO_PUBLIC_API_URL=

# Só no modo demonstração: força um estado da lista para mostrar no vídeo.
# Valores: normal | erro | vazio
EXPO_PUBLIC_CENARIO_DEMO=normal
